{
  "name": "crypto-income-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local crypto portfolio tracker + 24/7 market scanner with Discord alerts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "src/web"
  ],
  "scripts": {
    "start": "npm run build:web && node scripts/start.mjs",
    "dev": "concurrently -k \"node src/index.js\" \"npm run dev --workspace crypto-dashboard\"",
    "build:web": "npm run build --workspace crypto-dashboard",
    "serve:web": "node src/web/server.js",
    "import": "node scripts/import-excel.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
